<?xml version="1.0" encoding="utf-8"?>
<!-- The permissions and the playback service are declared in the manifest of `:core`. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only the phone chooses a rate by the network (NetworkReach): Wi-Fi or mobile data, and Data Saver. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Downloads keep going with the app in the background: a dataSync foreground service with a notification
         (DownloadService says why this type). The notification needs the permission from Android 13 on; without it
         the downloads still run, with no notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PhoneApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/App_Name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security"
        android:supportsRtl="true"
        android:theme="@style/Theme.RpmPhone">

        <!-- No orientation here: the app asks for one at run time (stage/StageOrientation.kt), portrait
             while nothing is loaded and the person's own rotation while something is, so a turned phone
             shows the stage. Android 16 ignores the request on screens 600 dp and wider. The configuration
             changes listed below are handled by Compose, so a rotation, a keyboard change or a new app
             language (settings/AppLanguages.kt) does not recreate the activity and lose what is on screen. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The browser's way back after a sign-in with Apple or Google (SignIn.returned). Another app can
                 register the same address, but the code in it is useless without this app's poll secret. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rpm" android:host="auth" />
            </intent-filter>
        </activity>

        <service
            android:name=".downloads.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
