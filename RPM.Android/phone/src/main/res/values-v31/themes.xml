<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- From Android 12 the system draws a launch screen with the launcher icon on it. Here it is the opening
         screen's instead: black, with the dimmed wordmark (opening_splash.xml) where shell/Opening.kt draws it. -->
    <style name="Theme.RpmPhone" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/opening_window</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/opening_splash</item>
    </style>
</resources>
